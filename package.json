{
  "name": "notes-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev",
    "dev:web": "bun --cwd apps/web run dev",
    "dev:api": "bun --cwd apps/api run dev",
    "build": "bun run --filter '*' build",
    "test": "bun --cwd apps/api run test",
    "lint": "bun --cwd apps/web run lint && bun --cwd apps/api run lint",
    "typecheck": "bun --cwd apps/web run typecheck && bun --cwd apps/api run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
